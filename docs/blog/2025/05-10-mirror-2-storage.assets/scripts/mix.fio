[global]
ioengine=libaio
direct=1
time_based
runtime=600
ramp_time=10
write_bw_log
write_iops_log
write_lat_log
disable_clat=1
disable_slat=1
log_avg_msec=1000

[job_http_small]
rw=randread
bs=5k
rate=100M
iodepth=32
numjobs=2

[job_http_medium]
rw=read
bs=512k
rate=80M
iodepth=16
numjobs=2

[job_http_large]
rw=read
bs=2m
rate=20M
iodepth=8
numjobs=1

[job_rsync_meta]
rw=randwrite
bs=4k
iodepth=1
numjobs=4
rate_iops=3000

[job_rsync_small]
rw=write
bs=5k
size=5G
iodepth=16
numjobs=1

[job_rsync_medium]
rw=write
bs=512k
size=20G
iodepth=8
numjobs=1

[job_rsync_large]
rw=write
bs=14m
size=10G
iodepth=4
numjobs=1
